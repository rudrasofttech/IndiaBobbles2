<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Admin.master.vb" Inherits="IndiaBobbles.Admin" %>

<%@ Import Namespace="IndiaBobbles" %>
<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>India Bobbles Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <link href="style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="ib-admin">

    <!-- ============ Sidebar ============ -->
    <aside class="adm-side" id="admSide">
        <a class="adm-brand" href="<%= ResolveUrl("~/admin/products.aspx") %>">
            <img src="<%= ResolveUrl("~/theme/khichdi/img/ib-logo.png") %>" alt="India Bobbles" />
            <span>Admin</span>
        </a>

        <nav class="adm-nav">
            <div class="grp">Shop</div>
            <a href="<%= ResolveUrl("~/admin/products.aspx") %>" data-match="product"><i class="fa fa-cube"></i> Products</a>
            <a href="<%= ResolveUrl("~/admin/orders.aspx") %>" data-match="order"><i class="fa fa-shopping-bag"></i> Orders</a>
            <a href="<%= ResolveUrl("~/admin/managecoupons.aspx") %>" data-match="coupon"><i class="fa fa-tag"></i> Coupons</a>
            <a href="<%= ResolveUrl("~/admin/tags.aspx") %>" data-match="tag"><i class="fa fa-tags"></i> Tags</a>

            <div class="grp">Customers</div>
            <a href="<%= ResolveUrl("~/admin/members.aspx") %>" data-match="member"><i class="fa fa-users"></i> Members</a>
            <%--<a href="<%= ResolveUrl("~/admin/communicate.aspx") %>" data-match="communicate"><i class="fa fa-comments"></i> Communicate</a>--%>

            <div class="grp">Email</div>
            <a href="<%= ResolveUrl("~/admin/emails.aspx") %>" data-match="emails"><i class="fa fa-envelope"></i> Emails</a>
            <a href="<%= ResolveUrl("~/admin/markettingcampaigns.aspx") %>" data-match="marketting|bulkemail"><i class="fa fa-paper-plane"></i> Marketting</a>

            <div class="grp">Content</div>
            <a href="<%= ResolveUrl("~/admin/articles.aspx") %>" data-match="article"><i class="fa fa-pencil-square-o"></i> Articles</a>
            <a href="<%= ResolveUrl("~/admin/managesitemap.aspx") %>" data-match="sitemap"><i class="fa fa-sitemap"></i> Sitemap</a>
            <a href="#" data-bs-toggle="modal" data-bs-target="#driveModal"><i class="fa fa-folder-open"></i> Drive (files)</a>
        </nav>

        <div class="adm-side-foot">
            <a href="<%= ResolveUrl("~/") %>" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> View website</a>
            <a href="https://dashboard.tawk.to" target="_blank" rel="noopener"><i class="fa fa-comment"></i> Live chat (tawk.to)</a>
        </div>
    </aside>
    <div class="adm-backdrop" id="admBackdrop"></div>

    <!-- ============ Main ============ -->
    <div class="adm-main">
        <header class="adm-top">
            <button type="button" class="adm-burger" id="admBurger" aria-label="Open menu"><i class="fa fa-bars"></i></button>
            <div class="adm-title"><%: Page.Title %></div>
            <a class="adm-top-link d-none d-sm-inline" href="<%= ResolveUrl("~/") %>" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> indiabobbles.com</a>
        </header>

        <div class="adm-content">
            <form id="mainform" runat="server">
                <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
                <asp:ContentPlaceHolder ID="Body" runat="server">
                </asp:ContentPlaceHolder>

                <div class="modal fade" id="driveModal" tabindex="-1" aria-labelledby="driveModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content" style="overflow:hidden;">
                            <div class="modal-header" style="background:#330B3F;color:#fff;">
                                <h5 class="modal-title" id="driveModalLabel"><i class="fa fa-folder-open" style="color:#ffc107;"></i> Drive <small style="font-size:.75rem;opacity:.75;font-weight:400;">– double-click an image (or “Use this image”) to insert it</small></h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <iframe title="Drive" style="width: 100%; height: 75vh; border: 0px; display: block;" runat="server" src="~/admin/viewdrive.aspx"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function () {
            // Highlight the current section in the sidebar
            var path = location.pathname.toLowerCase();
            document.querySelectorAll('.adm-nav a[data-match]').forEach(function (a) {
                var hit = a.getAttribute('data-match').split('|').some(function (m) { return path.indexOf(m) > -1; });
                if (hit) a.classList.add('active');
            });
            // Mobile menu
            var side = document.getElementById('admSide'), bd = document.getElementById('admBackdrop');
            function toggle(open) { side.classList.toggle('open', open); bd.classList.toggle('show', open); }
            document.getElementById('admBurger').addEventListener('click', function () { toggle(true); });
            bd.addEventListener('click', function () { toggle(false); });

            // ---------- Drive picker ----------
            // Remember the last text field you were in, so "Use this image" in Drive can fill it.
            var lastField = null;
            document.addEventListener('focusin', function (e) {
                var t = e.target;
                if ((t.tagName === 'TEXTAREA' || (t.tagName === 'INPUT' && /^(text|url|search)$/i.test(t.type))) && !t.closest('#driveModal')) lastField = t;
            });
            window.addEventListener('message', function (e) {
                if (e.origin !== location.origin || !e.data || e.data.type !== 'ib-drive-pick') return;
                var url = e.data.url, f = lastField;
                if (f) {
                    if (f.tagName === 'TEXTAREA') {
                        // In a text area (articles, emails) insert an image tag at the cursor
                        var tag = '<img src="' + url + '" alt="" style="max-width:100%;height:auto;" />';
                        var s = f.selectionStart || 0, en = f.selectionEnd || 0;
                        f.value = f.value.substring(0, s) + tag + f.value.substring(en);
                        f.selectionStart = f.selectionEnd = s + tag.length;
                    } else {
                        f.value = url;                     // image / path boxes get the link
                    }
                    f.dispatchEvent(new Event('input', { bubbles: true }));
                    f.dispatchEvent(new Event('change', { bubbles: true }));
                } else if (navigator.clipboard) {
                    navigator.clipboard.writeText(url);
                    alert('Image link copied – paste it where you need it.');
                }
                var m = document.getElementById('driveModal');
                if (m && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m).hide();
                if (f) setTimeout(function () { f.focus(); }, 300);
            });
        })();
    </script>
</body>
</html>